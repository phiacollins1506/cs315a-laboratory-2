from typing import List, Optional
from fastapi import FastAPI, Depends, HTTPException, status
from sqlalchemy.orm import Session

import models
import schemas
import crud
from database import engine, get_db

# Create database tables automatically
models.Base.metadata.create_all(bind=engine)

app = FastAPI(
title="GIPHCO Inventory Management API",
description="RESTful backend API for GIPHCO product inventory and catalog management.",
version="1.0.0"
)

# 1. POST /products/ - Add product to GIPHCO inventory (201 Created)
@app.post("/products/", response_model=schemas.ProductResponse, status_code=status.HTTP_201_CREATED)
def create_product(product: schemas.ProductCreate, db: Session = Depends(get_db)):
    return crud.create_product(db=db, product=product)

# 2. GET /products/ - Fetch GIPHCO catalog with pagination & category filter (200 OK)
@app.get("/products/", response_model=List[schemas.ProductResponse])
def read_products(
    skip: int = 0, 
    limit: int = 10, 
    category: Optional[str] = None, 
    db: Session = Depends(get_db)
    ):
    return crud.get_products(db, skip=skip, limit=limit, category=category)

# 3. GET /products/{product_id} - Fetch single product (200 OK)
@app.get("/products/{product_id}", response_model=schemas.ProductResponse)
def read_product(product_id: int, db: Session = Depends(get_db)):
    db_product = crud.get_product(db, product_id=product_id)
    if db_product is None:
        raise HTTPException(status_code=404, detail="Product not found in GIPHCO database")
    return db_product

# 4. PUT /products/{product_id} - Full update on existing product (200 OK)
@app.put("/products/{product_id}", response_model=schemas.ProductResponse)
def update_product(
    product_id: int, 
    product_update: schemas.ProductUpdate, 
    db: Session = Depends(get_db)
    ):
    updated_product = crud.update_product(db=db, product_id=product_id, product_update=product_update)
    if updated_product is None:
        raise HTTPException(status_code=404, detail="Product not found in GIPHCO database")
    return updated_product

# 5. PATCH /products/{product_id}/stock - Increment or decrement inventory count (200 OK)
@app.patch("/products/{product_id}/stock", response_model=schemas.ProductResponse)
def modify_stock(product_id: int, quantity: int, db: Session = Depends(get_db)):
    updated_product = crud.update_stock(db=db, product_id=product_id, quantity=quantity)
    if updated_product is None:
        raise HTTPException(status_code=404, detail="Product not found in GIPHCO database")
    return updated_product

# 6. DELETE /products/{product_id} - Delete discontinued product (204 No Content)
@app.delete("/products/{product_id}", status_code=status.HTTP_204_NO_CONTENT)
def delete_product(product_id: int, db: Session = Depends(get_db)):
    db_product = crud.delete_product(db=db, product_id=product_id)
    if db_product is None:
        raise HTTPException(status_code=404, detail="Product not found in GIPHCO database")
    return None
